# 복사해서 frontend/.env 로 만들고 값을 채웁니다. .env 는 커밋하지 않습니다.
# Supabase 대시보드 > Project Settings > API 에서 확인 (백엔드 담당에게 공유받기)
# EXPO_PUBLIC_ 접두사 값은 앱 번들에 포함되므로 anon key 만 넣습니다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# (선택) 안드로이드 APK 내려받기 주소. 웹의 '갤럭시·안드로이드 앱(APK) 받기' 버튼에 쓰이며, 비어 있으면 버튼이 숨겨집니다.
EXPO_PUBLIC_APK_URL=
